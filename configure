#!/bin/sh
set -eu

# 1) Setup
TA_SRC="src/ta-lib"
TA_PREFIX="$(cd "$TA_SRC" 2>/dev/null && pwd)/local"
PKG_CPPFLAGS=""
PKG_LIBS=""
USE_SYSTEM=0
CC_BIN="${CC:-cc}"

# 2) Try pkg-config first
if command -v pkg-config >/dev/null 2>&1 && pkg-config --exists ta-lib; then
  PKG_CPPFLAGS="$(pkg-config --cflags ta-lib)"
  PKG_LIBS="$(pkg-config --libs ta-lib)"
  # Add rpath for each discovered -L
  for d in $(pkg-config --libs-only-L ta-lib | sed 's/-L//g'); do
    PKG_LIBS="$PKG_LIBS -Wl,-rpath,$d"
  done
  USE_SYSTEM=1
  echo "configure: using system TA-Lib via pkg-config"
fi

# 3) Fallback probe (headers+link test)
if [ "$USE_SYSTEM" -eq 0 ]; then
  echo "configure: probing for system TA-Lib"
  cat > conftest.c <<'EOF'
#include <ta_libc.h>
int main(void){ return 0; }
EOF
  INC_DIRS="/usr/local/include/ta-lib /usr/include/ta-lib /opt/homebrew/include/ta-lib /opt/local/include/ta-lib"
  LIB_DIRS="/usr/local/lib /usr/lib /opt/homebrew/lib /opt/local/lib"
  for inc in $INC_DIRS ""; do
    [ -n "$inc" ] && [ ! -f "$inc/ta_libc.h" ] && continue
    for libd in $LIB_DIRS ""; do
      for lname in ta-lib ta_lib; do
        CPPTRY=""; LIBTRY="-l$lname"
        [ -n "$inc" ]  && CPPTRY="-I$inc -I$(dirname "$inc")"
        [ -n "$libd" ] && LIBTRY="-L$libd $LIBTRY"
        if $CC_BIN conftest.c -o conftest $CPPTRY $LIBTRY -lm >/dev/null 2>&1; then
          PKG_CPPFLAGS="$CPPTRY"
          PKG_LIBS="$LIBTRY -lm"
          [ -n "$libd" ] && PKG_LIBS="$PKG_LIBS -Wl,-rpath,$libd"
          USE_SYSTEM=1
          echo "configure: found TA-Lib at${inc:+ inc=$inc}${libd:+ lib=$libd} name=$lname"
          break 3
        fi
      done
    done
  done
  rm -f conftest conftest.c
fi

# 4) Vendored build if needed
if [ "$USE_SYSTEM" -eq 0 ]; then
  echo "configure: building vendored TA-Lib in $TA_SRC"
  [ -d "$TA_SRC" ] || { echo "ERROR: $TA_SRC not found"; exit 1; }
  cd "$TA_SRC"
  if [ ! -x ./configure ]; then
    if [ -f ./autogen.sh ]; then sh ./autogen.sh; fi
  fi
  CFLAGS="${CFLAGS:+$CFLAGS }-O3 -fPIC" ./configure --prefix="$TA_PREFIX"
  make -j"$( (getconf _NPROCESSORS_ONLN || printf 2) 2>/dev/null )"
  make install
  cd - >/dev/null

  # Normalize archive name across versions
  if   [ -f "$TA_PREFIX/lib/libta-lib.a" ]; then TA_A="$TA_PREFIX/lib/libta-lib.a"
  elif [ -f "$TA_PREFIX/lib/libta_lib.a" ]; then TA_A="$TA_PREFIX/lib/libta_lib.a"
  else echo "ERROR: TA-Lib static archive not found under $TA_PREFIX/lib"; exit 1
  fi

  PKG_CPPFLAGS="-I$TA_PREFIX/include -I$TA_PREFIX/include/ta-lib"
  PKG_LIBS="$TA_A -lm"
fi

# 5) Emit Makevars
echo "configure: writing src/Makevars"
cat > src/Makevars <<EOF
# autogenerated by configure
PKG_CPPFLAGS = $PKG_CPPFLAGS
PKG_LIBS = $PKG_LIBS
EOF

echo "configure: done."
