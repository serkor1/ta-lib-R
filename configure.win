#!/bin/sh
set -eu

TA_SRC="src/ta-lib"
TA_PREFIX="$(cd "$TA_SRC" 2>/dev/null && pwd)/local"
CC_BIN="${CC:-cc}"

nprocs() {
  if command -v nproc >/dev/null 2>&1; then nproc
  elif getconf _NPROCESSORS_ONLN >/dev/null 2>&1; then getconf _NPROCESSORS_ONLN
  else echo 2; fi
}

# 1) Build vendored TA-Lib out-of-tree
[ -d "$TA_SRC" ] || { echo "ERROR: $TA_SRC not found" >&2; exit 1; }
command -v cmake >/dev/null 2>&1 || { echo "ERROR: cmake not found" >&2; exit 1; }

# Satisfy upstream CMakeLists WIN32 'Platform' check
if [ -z "${Platform:-}" ]; then
  case "$(uname -m)" in x86_64|amd64) export Platform=x64 ;; aarch64) export Platform=arm64 ;; i*86) export Platform=x86 ;; *) export Platform=x64 ;; esac
fi

BUILDROOT="$(mktemp -d "${TMPDIR:-/tmp}/talib-win-build-XXXXXX")"
trap 'rm -rf "$BUILDROOT"' EXIT INT HUP TERM
GEN="MinGW Makefiles"; command -v ninja >/dev/null 2>&1 && GEN="Ninja"

cmake -S "$TA_SRC" -B "$BUILDROOT/cmake" -G "$GEN" \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_INSTALL_PREFIX="$TA_PREFIX" \
  -DBUILD_SHARED_LIBS=OFF \
  -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
  -DCMAKE_C_FLAGS_RELEASE="-O3 -march=native" \
  -DBUILD_DEV_TOOLS=OFF

cmake --build "$BUILDROOT/cmake" --config Release -- -j"$(nprocs)"
cmake --install "$BUILDROOT/cmake" --config Release --prefix "$TA_PREFIX"

# 2) Emit flags (relative to src/)
REL="ta-lib/local"
PKG_CPPFLAGS="-I$REL/include -I$REL/include/ta-lib"

if   [ -f "$TA_SRC/local/lib/libta-lib-static.a" ]; then
  PKG_LIBS="$REL/lib/libta-lib-static.a"
elif [ -f "$TA_SRC/local/lib/libta-lib.a" ]; then
  PKG_LIBS="$REL/lib/libta-lib.a"
elif [ -f "$TA_SRC/local/lib/libta-lib.dll.a" ]; then
  PKG_LIBS="-L$REL/lib -lta-lib"
else
  echo "ERROR: TA-Lib library not found under $TA_SRC/local/lib" >&2
  exit 1
fi

# 3) Sanity check header from package ROOT using src-prefixed include dirs
cat > conftest.c <<'EOF'
#include <ta_libc.h>
int main(void){return 0;}
EOF
TEST_CPPFLAGS="-Isrc/$REL/include -Isrc/$REL/include/ta-lib"
"$CC_BIN" -c conftest.c $TEST_CPPFLAGS >/dev/null 2>&1 || {
  echo "ERROR: ta_libc.h not found with TEST_CPPFLAGS: $TEST_CPPFLAGS" >&2
  rm -f conftest.c conftest.o
  exit 1
}
rm -f conftest.c conftest.o

# 4) Write Makevars.win (compiler runs in src/, so src-prefix not needed)
echo "configure.win: writing src/Makevars.win"
cat > src/Makevars.win <<EOF
# autogenerated by configure.win
PKG_CPPFLAGS = $PKG_CPPFLAGS
PKG_LIBS = $PKG_LIBS
EOF

echo "configure.win: done."
