#!/bin/sh
set -eu

# 1) Setup
TA_SRC="src/ta-lib"
TA_PREFIX="$(cd "$TA_SRC" 2>/dev/null && pwd)/local"
PKG_CPPFLAGS=""
PKG_LIBS=""
USE_SYSTEM=0
CC_BIN="${CC:-cc}"

nprocs() {
  if command -v nproc >/dev/null 2>&1; then nproc
  elif getconf _NPROCESSORS_ONLN >/dev/null 2>&1; then getconf _NPROCESSORS_ONLN
  else echo 2; fi
}

# 2) Try system TA-Lib via pkg-config (MSYS2 environments)
if command -v pkg-config >/dev/null 2>&1 && pkg-config --exists ta-lib; then
  PKG_CPPFLAGS="$(pkg-config --cflags ta-lib)"
  PKG_LIBS="$(pkg-config --libs ta-lib)"   # no rpath on Windows
  USE_SYSTEM=1
  echo "configure.win: using system TA-Lib via pkg-config"
fi

# 3) Probe for system TA-Lib without pkg-config
#    Search typical Mingw prefixes; reject MSVC .lib binaries implicitly.
if [ "$USE_SYSTEM" -eq 0 ]; then
  echo "configure.win: probing for system TA-Lib"
  cat > conftest.c <<'EOF'
#include <ta_libc.h>
int main(void){ return 0; }
EOF

  # Prefer the active MSYS2 root if available
  ROOTS=""
  case "${MSYSTEM:-}" in
    UCRT64)  ROOTS="/ucrt64" ;;
    MINGW64) ROOTS="/mingw64" ;;
    MINGW32) ROOTS="/mingw32" ;;
    CLANG64) ROOTS="/clang64" ;;
  esac
  ROOTS="$ROOTS /usr/local /usr"

  # Optional user hints
  [ -n "${TA_LIB_ROOT:-}" ] && ROOTS="$TA_LIB_ROOT $ROOTS"
  [ -n "${TA_LIB_DIR:-}"  ] && ROOTS="$TA_LIB_DIR $ROOTS"

  for r in $ROOTS; do
    INC_CAND="$r/include/ta-lib"
    LIBDIRS="$r/lib $r/lib64"
    [ -d "$INC_CAND" ] || continue
    for libd in $LIBDIRS; do
      [ -d "$libd" ] || continue
      # Prefer Mingw import/static archives (*.a). Do not try MSVC *.lib.
      for lname in ta-lib ta_lib; do
        if "$CC_BIN" conftest.c -o conftest -I"$INC_CAND" -I"$(dirname "$INC_CAND")" -L"$libd" -l"$lname" >/dev/null 2>&1; then
          PKG_CPPFLAGS="-I$INC_CAND -I$(dirname "$INC_CAND")"
          PKG_LIBS="-L$libd -l$lname"
          USE_SYSTEM=1
          echo "configure.win: found TA-Lib at inc=$INC_CAND lib=$libd name=$lname"
          break 3
        fi
      done
    done
  done
  rm -f conftest conftest.exe
fi

# 4) Vendored build (CMake ≥ 3.30 required by upstream on Windows)
if [ "$USE_SYSTEM" -eq 0 ]; then
  echo "configure.win: building vendored TA-Lib"
  [ -d "$TA_SRC" ] || { echo "ERROR: $TA_SRC not found" >&2; exit 1; }

  command -v cmake >/dev/null 2>&1 || { echo "ERROR: cmake not found" >&2; exit 1; }
  set +e
  set -- $(cmake --version | sed -n '1s/.* version \([0-9][0-9]*\)\.\([0-9][0-9]*\).*/\1 \2/p')
  set -e
  CM_MAJ=${1:-0}; CM_MIN=${2:-0}
  if [ "$CM_MAJ" -lt 3 ] || { [ "$CM_MAJ" -eq 3 ] && [ "$CM_MIN" -lt 30 ]; }; then
    echo "ERROR: Need CMake >= 3.30 on Windows; found ${CM_MAJ}.${CM_MIN}" >&2
    exit 1
  fi

  BUILDROOT="$(mktemp -d "${TMPDIR:-/tmp}/talib-win-build-XXXXXX")"
  trap 'rm -rf "$BUILDROOT"' EXIT INT HUP TERM

  # Upstream expects Platform env when WIN32; set a sane default
  if [ -z "${Platform:-}" ]; then
    case "$(uname -m)" in
      x86_64|amd64) export Platform=x64 ;;
      aarch64)      export Platform=arm64 ;;
      i*86)         export Platform=x86 ;;
      *)            export Platform=x64 ;;
    esac
  fi

  GEN="MinGW Makefiles"
  command -v ninja >/dev/null 2>&1 && GEN="Ninja"

  cmake -S "$TA_SRC" -B "$BUILDROOT/cmake" -G "$GEN" \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX="$TA_PREFIX" \
    -DBUILD_SHARED_LIBS=OFF \
    -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
    -DCMAKE_C_FLAGS_RELEASE="-O3 -march=native" \
    -DBUILD_DEV_TOOLS=OFF

  cmake --build "$BUILDROOT/cmake" --target install -- -j"$(nprocs)"

  # Emit flags for vendored install (relative to src/)
  REL="ta-lib/local"
  PKG_CPPFLAGS="-I$REL/include -I$REL/include/ta-lib"
  if   [ -f "$TA_SRC/local/lib/libta-lib.a" ]; then
    PKG_LIBS="$REL/lib/libta-lib.a"
  elif [ -f "$TA_SRC/local/lib/libta-lib.dll.a" ]; then
    PKG_LIBS="-L$REL/lib -lta-lib"
  else
    echo "ERROR: TA-Lib library not found under $TA_SRC/local/lib" >&2
    exit 1
  fi
fi

# 5) Sanity check header
cat > conftest.c <<'EOF'
#include <ta_libc.h>
int main(void){return 0;}
EOF
"$CC_BIN" -c conftest.c $PKG_CPPFLAGS >/dev/null 2>&1 || {
  echo "ERROR: ta_libc.h not found with PKG_CPPFLAGS: $PKG_CPPFLAGS" >&2
  rm -f conftest.c conftest.o
  exit 1
}
rm -f conftest.c conftest.o

# 6) Write Makevars.win
echo "configure.win: writing src/Makevars.win"
cat > src/Makevars.win <<EOF
# autogenerated by configure.win
PKG_CPPFLAGS = $PKG_CPPFLAGS
PKG_LIBS = $PKG_LIBS
EOF

echo "configure.win: done."
