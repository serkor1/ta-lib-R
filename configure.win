#!/bin/sh
set -eu

# 1) Setup
TA_SRC="src/ta-lib"
TA_PREFIX="$(cd "$TA_SRC" 2>/dev/null && pwd)/local"
PKG_CPPFLAGS=""
PKG_LIBS=""
CC_BIN="${CC:-cc}"

nprocs() {
  if command -v nproc >/dev/null 2>&1; then nproc
  elif getconf _NPROCESSORS_ONLN >/dev/null 2>&1; then getconf _NPROCESSORS_ONLN
  else echo 2; fi
}

# 2) Hard requirement: CMake >= 3.30 on Windows (per upstream CMakeLists)
command -v cmake >/dev/null 2>&1 || { echo "ERROR: cmake not found in PATH" >&2; exit 1; }
set +e
set -- $(cmake --version | sed -n '1s/.* version \([0-9][0-9]*\)\.\([0-9][0-9]*\).*/\1 \2/p')
set -e
CM_MAJ=${1:-0}; CM_MIN=${2:-0}
if [ "$CM_MAJ" -lt 3 ] || { [ "$CM_MAJ" -eq 3 ] && [ "$CM_MIN" -lt 30 ]; }; then
  echo "ERROR: Need CMake >= 3.30 on Windows; found ${CM_MAJ}.${CM_MIN}" >&2
  exit 1
fi

# 3) Build vendored TA-Lib out-of-tree (keeps src/ clean for R CMD check)
[ -d "$TA_SRC" ] || { echo "ERROR: $TA_SRC not found" >&2; exit 1; }
BUILDROOT="$(mktemp -d "${TMPDIR:-/tmp}/talib-win-build-XXXXXX")"
trap 'rm -rf "$BUILDROOT"' EXIT INT HUP TERM

# Upstream CMakeLists expects an MSVC-style Platform env on WIN32; set a sane value.
if [ -z "${Platform:-}" ]; then
  case "$(uname -m)" in
    x86_64|amd64) export Platform=x64 ;;
    aarch64)      export Platform=arm64 ;;
    i*86)         export Platform=x86 ;;
    *)            export Platform=x64 ;;
  esac
fi

# Pick generator
GEN="MinGW Makefiles"
command -v ninja >/dev/null 2>&1 && GEN="Ninja"

echo "configure.win: CMake generator: $GEN"
cmake -S "$TA_SRC" -B "$BUILDROOT/cmake" -G "$GEN" \
  -DCMAKE_BUILD_TYPE=Release \
  -DCMAKE_INSTALL_PREFIX="$TA_PREFIX" \
  -DBUILD_SHARED_LIBS=OFF \
  -DCMAKE_POSITION_INDEPENDENT_CODE=ON \
  -DCMAKE_C_FLAGS_RELEASE="-O3 -march=native" \
  -DBUILD_DEV_TOOLS=OFF

cmake --build "$BUILDROOT/cmake" --target install -- -j"$(nprocs)"

# 4) Emit flags (relative to src/)
REL="ta-lib/local"
PKG_CPPFLAGS="-I$REL/include -I$REL/include/ta-lib"

LIBDIR="$TA_SRC/local/lib"
if   [ -f "$LIBDIR/libta-lib-static.a" ]; then
  PKG_LIBS="$REL/lib/libta-lib-static.a"
elif [ -f "$LIBDIR/libta-lib.a" ]; then
  PKG_LIBS="$REL/lib/libta-lib.a"
elif [ -f "$LIBDIR/libta-lib.dll.a" ]; then
  # import lib for the DLL; prefer static if present
  PKG_LIBS="-L$REL/lib -lta-lib"
else
  echo "ERROR: TA-Lib library not found under $LIBDIR" >&2
  exit 1
fi

# 5) Sanity check header
cat > conftest.c <<'EOF'
#include <ta_libc.h>
int main(void){return 0;}
EOF
"$CC_BIN" -c conftest.c $PKG_CPPFLAGS >/dev/null 2>&1 || {
  echo "ERROR: ta_libc.h not found with PKG_CPPFLAGS: $PKG_CPPFLAGS" >&2
  rm -f conftest.c conftest.o
  exit 1
}
rm -f conftest.c conftest.o

# 6) Write src/Makevars.win
echo "configure.win: writing src/Makevars.win"
cat > src/Makevars.win <<EOF
# autogenerated by configure.win
PKG_CPPFLAGS = $PKG_CPPFLAGS
PKG_LIBS = $PKG_LIBS
EOF

echo "configure.win: done."
