# Man files
/**/*.Rd
# html files
/**/*.html
# History files
.Rhistory
.Rapp.history

# Session Data files
.RData
.RDataTmp

# User-specific files
.Ruserdata

# Example code in package build process
*-Ex.R

# Output files from R CMD build
/*.tar.gz

# Output files from R CMD check
/*.Rcheck/

# RStudio files
.Rproj.user/

# produced vignettes
vignettes/*.html
vignettes/*.pdf

# OAuth2 token, see https://github.com/hadley/httr/releases/tag/v0.3
.httr-oauth

# knitr and R markdown default cache directories
*_cache/
/cache/

# Temporary files created by R markdown
*.utf8.md
*.knit.md

# R Environment Variables
.Renviron

# pkgdown site
docs/
pkgdown/

# translation temp files
po/*~

# RStudio Connect folder
rsconnect/
.Rproj.user

# Makevars
src/Makevars

# Leftover graphics-device artifact
Rplots.pdf

# Empty scratch dir from earlier builds
figure/

# Building notes
NOTES.md

# sandbox
sandbox/**

docs
inst/doc

/.quarto/



## ignore files in benchmark
benchmark/*.rds

## Parity snapshots are regenerated from upstream on every run; no value
## in tracking them. The standalone exe is also a build artifact.
## tests/testthat/test-parity.R is auto-generated from the template at
## codegen/parity/test_parity_template.R by `make parity-prepare`.
tests/parity/snapshot/
tests/testthat/test-parity.R
codegen/parity/parity_gen
codegen/parity/parity_gen.exe